rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Option A: OPEN DEVELOPMENT CONFIGURATION (Recommended for fast troubleshooting)
    // Allows anyone with your database URL to read/write all collections during setup.
    // ==========================================
    match /{document=**} {
      allow read, write: if true;
    }

    // ==========================================
    // Option B: AUTHENTICATED SECURE CONFIGURATION
    // Restricts read/write operations to authenticated accounts in the CRM.
    // To use this, comment out Option A above and uncomment the block below.
    // ==========================================
    /*
    match /customers/{document} {
      allow read, write: if request.auth != null;
    }
    match /bookings/{document} {
      allow read, write: if request.auth != null;
    }
    match /technicians/{document} {
      allow read, write: if request.auth != null;
    }
    match /spares/{document} {
      allow read, write: if request.auth != null;
    }
    match /expenses/{document} {
      allow read, write: if request.auth != null;
    }
    match /outstanding/{document} {
      allow read, write: if request.auth != null;
    }
    match /leads/{document} {
      allow read, write: if request.auth != null;
    }
    match /contacts/{document} {
      allow read, write: if request.auth != null;
    }
    match /reminders/{document} {
      allow read, write: if request.auth != null;
    }
    match /assets/{document} {
      allow read, write: if request.auth != null;
    }
    match /employees/{document} {
      allow read, write: if request.auth != null;
    }
    match /payouts/{document} {
      allow read, write: if request.auth != null;
    }
    */
  }
}
